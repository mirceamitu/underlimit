    "upload-limit",
    "offline",
    "ccitt",
    "fax",
    "cli",
    "ai-agents",
    "agent-skills"
  ],
  "homepage": "https://mirceamitu.github.io/underlimit/",
  "repository": "github:mirceamitu/underlimit",
  "license": "MIT",
  "type": "module",
  "bin": {
    "underlimit": "cli.mjs"
  },
  "files": [
    "cli.mjs",
    "src/",
    "skills/"
  ],
  "scripts": {
